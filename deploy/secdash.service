# /etc/systemd/system/secdash.service
# 전용 계정(secdash)으로 실행하고 필요한 최소 권한만 capability 로 부여한다.
[Unit]
Description=Security Dashboard (view/triage layer over fail2ban, auth.log, dpkg, /proc)
After=network-online.target fail2ban.service rsyslog.service
Wants=network-online.target

[Service]
Type=simple
User=secdash
Group=secdash
SupplementaryGroups=adm
WorkingDirectory=/opt/secdash/backend
EnvironmentFile=-/etc/secdash/secdash.env
ExecStart=/opt/secdash/backend/venv/bin/python app.py
Restart=on-failure
RestartSec=5

# 권한: auth.log 는 adm 그룹으로, /etc/shadow·다른 사용자의 /proc 은 capability 로 읽는다.
# CAP_DAC_READ_SEARCH : 읽기 전용 파일 접근 (shadow, sudoers, 다른 홈의 authorized_keys, cron spool)
# CAP_SYS_PTRACE      : 다른 사용자 프로세스의 exe/cwd/fd 확인 (리버스 셸, /tmp 실행 탐지)
# CAP_NET_ADMIN       : 소켓 → 프로세스 귀속 (psutil.net_connections)
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_NET_ADMIN
# CapabilityBoundingSet 은 두지 않는다: setuid 인 sudo 가 root 권한을 얻어야 fail2ban-client 를 호출할 수 있다.
NoNewPrivileges=false
# fail2ban 제어는 sudo -n fail2ban-client 로만 한다 (deploy/sudoers-secdash).
# sudo 는 /run/sudo 에 타임스탬프를 쓰므로 ProtectSystem=strict 아래에서 그 경로만 열어 준다.
ExecStartPre=+/usr/bin/install -d -m 0711 -o root -g root /run/sudo

# 하드닝
ProtectSystem=strict
ReadWritePaths=/opt/secdash/backend /run/sudo
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
