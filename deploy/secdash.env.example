# /etc/secdash/secdash.env  (권한 0640 root:secdash)
SECDASH_HOST=127.0.0.1
SECDASH_PORT=8000
SECDASH_AUTH_LOG=/var/log/auth.log
SECDASH_FAIL2BAN_JAIL=sshd
# 관리자 IP·대역 (공백 구분). 대시보드는 이 주소를 차단하지 않고, fail2ban ignoreip 에도 들어간다.
# 원격 서버라면 반드시 채우세요 — 비워 두면 비밀번호를 몇 번 틀린 관리자도 차단될 수 있습니다.
# 고친 뒤: sudo deploy/apply-host-config.sh && sudo systemctl restart secdash
#SECDASH_F2B_IGNOREIP=203.0.113.7 198.51.100.0/24
# SSH 포트 (공백 구분, 기본 22). 로그인해 있는 관리자 세션을 알아보는 데 쓴다
#SECDASH_SSH_PORTS=22
# 서버 역할 메모. 강화 작업 목록을 Claude 등에 붙여넣을 때 맥락으로 포함된다
#SECDASH_HOST_ROLE=GPU 개발 서버, 물리 접근 가능, 인쇄 없음, 외부 파일 유입 없음
# 토큰을 고정하려면 지정 (미지정 시 backend/.api_token 자동 생성)
#SECDASH_API_TOKEN=
# Slack Webhook (선택)
#SLACK_WEBHOOK_URL=
# 위협 인텔 뉴스 제목 번역/긴급도 평가 (선택, 호스트 로그는 절대 전송되지 않음)
#ANTHROPIC_API_KEY=
#SECDASH_INTEL_TRANSLATE=1
# Ubuntu USN 과 설치 패키지 대조
SECDASH_USN_MATCH=1
SECDASH_EVENT_RETENTION_DAYS=30
SECDASH_ALERT_RETENTION_DAYS=90
