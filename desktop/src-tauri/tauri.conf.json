{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sentinel Overwatch",
  "mainBinaryName": "sentinel-desktop",
  "version": "0.1.1",
  "identifier": "io.github.kunmyonchoi.sentinel",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "내 컴퓨터 지킴이",
        "width": 1180,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8000",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' data: blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "publisher": "KunmyonChoi",
    "category": "Utility",
    "shortDescription": "내 컴퓨터 지킴이 — 트레이에 상주하는 보안 대시보드",
    "longDescription": "fail2ban·auth.log·auditd 위에서 동작하는 보안 대시보드(Sentinel Overwatch)를 자기 창으로 연다. 트레이 아이콘으로 지금 상태를 보여주고, 긴급 알림은 OS 알림으로 띄운다. 같은 컴퓨터의 백엔드(127.0.0.1:8000)에 붙는다.",
    "linux": {
      "deb": {
        "section": "admin",
        "desktopTemplate": "linux/sentinel.desktop"
      }
    }
  }
}
