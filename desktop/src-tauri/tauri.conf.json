{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "내 컴퓨터 지킴이",
  "version": "0.1.0",
  "identifier": "io.github.kunmyonchoi.sentinel",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "내 컴퓨터 지킴이",
        "width": 1180,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
